# Eldoria: Forgotten Wilds — Local Self-Hosted Configuration Example
# Copy to .env for local execution (NEVER commit real production secrets)

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local Auth Secret (replace with random 64-char hex)
JWT_ACCESS_SECRET=eldoria_local_dev_jwt_secret_change_me_64hex_0123456789abcdef0123

# Primary Persistent Database (100% Local JSON — NON-NEGOTIABLE)
DATA_DB_DIR=./data/db
DATA_BACKUP_DIR=./data/backups
GAME_DATA_DIR=./game-data
ASSETS_DIR=./assets

# Game Simulation Loop
SIM_TICK_HZ=20
SNAPSHOT_HZ=10
DIRTY_FLUSH_INTERVAL_MS=30000
BACKUP_INTERVAL_HOURS=6
DISK_LOW_THRESHOLD_PCT=15

# Local Docker Redis (Ephemeral Runtime Cache Only — Automatic RAM Fallback)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=eldoria:

# Local Docker MinIO (S3-Compatible Local Asset & Backup Storage — Zero Cloud)
ASSET_STORAGE_MODE=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=eldoria_local_admin
MINIO_SECRET_KEY=eldoria_local_secret_key_2026
MINIO_BUCKET_ASSETS=eldoria-assets
MINIO_BUCKET_BACKUPS=eldoria-backups
