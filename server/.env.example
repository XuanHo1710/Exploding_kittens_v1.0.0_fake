# File JSON tài khoản trên Drive là nơi lưu chính.
ACCOUNT_STORAGE=google-drive
GOOGLE_DRIVE_DB_FILE_ID=

# OAuth của CHỦ SERVER; không phải tài khoản Google của người chơi.
# Điền ID/secret rồi chạy: npm --prefix server run drive:setup -- --create-file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Chỉ dùng thay OAuth khi dùng service account với Shared Drive.
# Không điền đồng thời cả hai cơ chế xác thực.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/service-account.json

PORT=3001

# Để phát triển hoàn toàn cục bộ: ACCOUNT_STORAGE=local
